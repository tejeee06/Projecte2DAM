{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "rootDir": "./src",              
    "outDir": "./dist",               
    "esModuleInterop": true,         
    "forceConsistentCasingInFileNames": true,
    "strict": true,                 
    "skipLibCheck": true  
  },

  "include": ["src/**/*"]
}
